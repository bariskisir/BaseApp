{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "vite.config.mts",
    "vitest.config.mts",
    "src/app/base/common/**/*.ts",
    "src/app/base/node/**/*.ts",
    "src/app/base/parts/ipc/common/**/*.ts",
    "src/app/base/parts/ipc/electron-main/**/*.ts",
    "src/app/base/parts/sandbox/common/**/*.ts",
    "src/app/base/parts/sandbox/electron-browser/preload.ts",
    "src/app/platform/**/*.ts",
    "src/app/code/electron-main/**/*.ts"
  ],
  "exclude": ["src/app/platform/**/electron-browser/**/*.ts", "src/app/**/test/**/*.ts"]
}
