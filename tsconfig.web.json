{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": [
    "src/app/base/common/**/*.ts",
    "src/app/base/browser/**/*.ts",
    "src/app/base/parts/ipc/common/**/*.ts",
    "src/app/base/parts/ipc/electron-browser/**/*.ts",
    "src/app/base/parts/sandbox/common/**/*.ts",
    "src/app/platform/**/common/**/*.ts",
    "src/app/platform/**/electron-browser/**/*.ts",
    "src/app/workbench/**/*.ts",
    "src/app/code/electron-browser/**/*.ts"
  ],
  "exclude": ["src/app/**/test/**/*.ts"]
}
