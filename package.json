{
  "name": "baseapp",
  "version": "2.0.0",
  "description": "Reusable Electron desktop application starter",
  "keywords": ["electron", "typescript", "desktop", "starter"],
  "homepage": "https://github.com/bariskisir/BaseApp#readme",
  "bugs": "https://github.com/bariskisir/BaseApp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bariskisir/BaseApp.git"
  },
  "main": "./out/main/index.js",
  "author": "bariskisir",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "start": "npm run build && electron .",
    "build": "npm run typecheck && vite build",
    "verify": "npm run lint && npm run test && npm run format:check && npm run build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "biome lint src vite.config.mts vitest.config.mts",
    "format": "prettier --write \"src/**/*.{ts,scss,html}\" vite.config.mts vitest.config.mts",
    "format:check": "prettier --check \"src/**/*.{ts,scss,html}\" vite.config.mts vitest.config.mts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win nsis --x64 --arm64 --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg --x64 --arm64 --publish never",
    "package:linux": "npm run build && electron-builder --linux --x64 --arm64 --publish never",
    "package:linux:x64": "npm run build && electron-builder --linux --x64 --publish never",
    "package:linux:arm64": "npm run build && electron-builder --linux --arm64 --publish never"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "i18next": "27.2.6",
    "prettier": "3.10.1",
    "sass": "1.108.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-electron": "1.2.0",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "build": {
    "appId": "com.bariskisir.baseapp",
    "productName": "BaseApp",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": ["out/**/*", "package.json", "LICENSE"],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/tray-icon-bluetooth.png",
        "to": "tray-icon-bluetooth.png"
      },
      {
        "from": "build/tray-icon-weather.png",
        "to": "tray-icon-weather.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "arm64"]
        }
      ],
      "artifactName": "${name}-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "differentialPackage": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "build/icon.png",
      "target": "dmg",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": ["AppImage"],
      "category": "Utility",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  }
}
